{
  "name": "leaf",
  "version": "1.1.0",
  "description": "A multipurpose Discord bot and web dashboard, built through AI-assisted development.",
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "prestart": "node scripts/setup.js",
    "start": "node index.js",
    "dev": "node scripts/setup.js && node --watch index.js",
    "web": "node scripts/setup.js && node index.js --web-only",
    "bot": "node scripts/setup.js && node index.js --bot-only",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "setup:images": "node scripts/setup-images.js"
  },
  "keywords": [
    "discord",
    "bot",
    "dashboard",
    "learning-project",
    "ai-assisted-development"
  ],
  "author": "Zyless",
  "license": "UNLICENSED",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.76",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "canvas": "^3.1.2",
    "chrono-node": "^2.10.1",
    "discord-arts": "^0.7.1",
    "discord.js": "^14.21.0",
    "emoji-regex": "^11.0.0",
    "figlet": "^1.8.2",
    "form-data": "^4.0.4",
    "franc-min": "^6.2.0",
    "google-translate-api-x": "^10.7.2",
    "jimp": "^0.16.1",
    "langs": "^2.0.0",
    "luxon": "^3.7.1",
    "mathjs": "^15.2.0",
    "ms": "^2.1.3",
    "night-api": "^1.3.0",
    "node-fetch": "^3.3.2",
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "night-api": {
      "axios": "^1.15.0"
    }
  }
}
